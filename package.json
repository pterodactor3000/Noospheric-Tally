{
  "name": "noospheric-tally",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "worker:build": "opennextjs-cloudflare build",
    "worker:check": "pnpm worker:build && wrangler deploy --dry-run",
    "worker:deploy": "opennextjs-cloudflare deploy",
    "deploy": "pnpm worker:build && pnpm worker:deploy",
    "upload": "pnpm worker:build && opennextjs-cloudflare upload",
    "preview": "pnpm worker:build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types-interface CloudflareEnv ./cloudflare-env.d.ts && node ./scripts/patch-cloudflare-env-types.mjs",
    "bump:patch": "pnpm version patch --no-git-tag-version",
    "bump:minor": "pnpm version minor --no-git-tag-version",
    "bump:major": "pnpm version major --no-git-tag-version"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.2.11",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0"
  },
  "devDependencies": {
    "@pterodactor3000/silica-animus": "^0.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.10.0",
    "eslint-config-next": "16.2.11",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
